# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAH-your-bot-token-here

# Telegram ID администратора (узнать через @userinfobot)
ADMIN_CHAT_ID=123456789

# Путь к файлу экскурсии (PDF или DOCX)
EXCURSION_FILE_PATH=./files/excursion.pdf

# Путь к файлу базы данных SQLite
DATABASE_PATH=./data/bot.db

# Час для автоматической рассылки (по умолчанию 10)
DAILY_BROADCAST_HOUR=10
